 "font_size": 14,
 "html": "<div style = \"border:2px solid black;padding:20px\">\r\n\r\n{% if doc.status != \"Approved\" and doc.status != \"Reimbursed\" %}\r\n<div class=\"banner\">\r\n  PENDING APPROVAL \u2014 NOT YET REIMBURSABLE\r\n</div>\r\n{% endif %}\r\n\r\n<div class=\"summary\">\r\n  <h2>Employee & Department</h2>\r\n  <p><strong>Employee:</strong> {{ doc.employee }}</p>\r\n  <p><strong>Department:</strong> {{ doc.department }}</p>\r\n  <p><strong>Date:</strong> {{ doc.expense_date }}</p>\r\n</div>\r\n\r\n<table class=\"expense-table\" style=\"width:100%; border-collapse:collapse;\">\r\n  <thead>\r\n    <tr>\r\n      <th style=\"text-align:left; border-bottom:1px solid #ccc;\">Description</th>\r\n      <th style=\"text-align:right; border-bottom:1px solid #ccc;\">Amount</th>\r\n    </tr>\r\n  </thead>\r\n  <tbody>\r\n    {% for line in doc.expense_lines %}\r\n    <tr>\r\n      <td style=\"padding:4px 8px;\">{{ line.description }}</td>\r\n      <td style=\"padding:4px 8px; text-align:right;\">{{ line.amount }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n  </tbody>\r\n  <tfoot>\r\n    <tr>\r\n      <td style=\"padding:4px 8px;\"><strong>Total</strong></td>\r\n      <td style=\"padding:4px 8px; text-align:right;\" class=\"total\">{{ doc.total_amount }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td style=\"padding:4px 8px;\"><strong>Remaining Budget at Submission</strong></td>\r\n      <td style=\"padding:4px 8px; text-align:right;\" class=\"total\">{{ doc.remaining_budget_at_submission}}</td>\r\n    </tr>\r\n  </tfoot>\r\n</table>\r\n</div>\r\n",
